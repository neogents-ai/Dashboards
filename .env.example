# NEO Gents Dashboards — environment variables

# Gmail account used to send affiliate signup notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Secret token for /affiliates/admin access
AFFILIATE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: directory where affiliate data JSON is stored
DATA_DIR=./data

# Optional: base URL for API calls from the frontend
# VITE_API_BASE_URL=https://your-api-domain.com
