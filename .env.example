# NEO Gents Dashboards — environment variables

# Public Formspree endpoints (signups also forward here so you can review submissions)
VITE_FORMSPREE_AUDIT_ENDPOINT=https://formspree.io/f/YOUR_AUDIT_FORM_ID
VITE_FORMSPREE_AFFILIATE_ENDPOINT=https://formspree.io/f/YOUR_AFFILIATE_FORM_ID

# Base URL for the Cloudflare Pages Functions API (empty = same origin)
# For local Vite dev against a remote backend: https://neogents.tech
VITE_API_BASE_URL=

# Neon PostgreSQL connection string (used by Cloudflare Pages Functions)
# Set this as a Cloudflare Pages secret: wrangler pages secret put DATABASE_URL
DATABASE_URL=postgresql://user:pass@host.neon.tech/neogents?sslmode=require

# Secret token for /affiliates/admin access
# Set this as a Cloudflare Pages secret: wrangler pages secret put AFFILIATE_ADMIN_TOKEN
AFFILIATE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: legacy Express server data directory (not used in Cloudflare backend)
DATA_DIR=./data
