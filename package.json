{
  "name": "neogents-dashboards",
  "version": "1.0.0",
  "description": "NEO Gents Dashboards — Cloudflare Pages + D1",
  "scripts": {
    "build": "cd artifacts/mockup-sandbox && npm ci && npm run build",
    "dev": "cd artifacts/mockup-sandbox && npm run dev",
    "preview": "cd artifacts/mockup-sandbox && npm run preview",
    "deploy": "wrangler pages deploy",
    "d1:migrate": "wrangler d1 migrations apply neogents-affiliates",
    "d1:list": "wrangler d1 migrations list neogents-affiliates"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.65.0"
  }
}
